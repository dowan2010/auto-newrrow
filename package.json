{
  "name": "auto-newrrow",
  "version": "1.3.0",
  "description": "뉴로우(newrrow) 일일 계획·회고 자동화 CLI",
  "type": "module",
  "license": "GPL-3.0-only",
  "bin": {
    "newrrow": "cli.js"
  },
  "files": [
    "cli.js",
    "automation.js",
    "lib/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "newrrow",
    "뉴로우",
    "automation",
    "cli",
    "playwright"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dowan2010/newrrowBot.git"
  },
  "scripts": {
    "start": "node cli.js",
    "postinstall": "playwright install chromium",
    "app": "electron .",
    "dist": "electron-builder --mac dmg"
  },
  "dependencies": {
    "dotenv": "^16.0.0",
    "playwright": "^1.44.0"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "main": "app/main.js",
  "build": {
    "appId": "com.daymark.autonewrrow",
    "productName": "Auto Newrrow",
    "files": [
      "app/**",
      "lib/client.js",
      "lib/core.js",
      "lib/ai.js",
      "lib/data.js",
      "lib/paths.js",
      "lib/daily.js",
      "package.json",
      "!**/node_modules/**"
    ],
    "extraMetadata": {
      "main": "app/main.js"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false,
      "icon": "build/icon.icns",
      "artifactName": "Auto-Newrrow-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "Auto Newrrow"
    },
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Auto-Newrrow-${version}-win-${arch}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Auto Newrrow"
    }
  }
}
